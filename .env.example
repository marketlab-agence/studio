# =============================================================================
# Katalyst — Variables d'environnement (EXEMPLE)
# =============================================================================
# Copier en `.env.local` et renseigner les valeurs réelles.
# `.env*` est gitignoré : ne JAMAIS commiter de secret.
#
# Les variables marquées [phase N] sont introduites par une phase du plan
# (voir `.kiro/specs/katalyst/tasks.md`). Elles sont documentées ici dès
# maintenant pour préparer la migration.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase — Web SDK (client)                        [supprimé en phase 7]
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# -----------------------------------------------------------------------------
# Firebase — Admin SDK (serveur)                     [supprimé en phase 7]
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Clé privée : conserver les \n échappés, entourer de guillemets doubles.
FIREBASE_PRIVATE_KEY=""

# -----------------------------------------------------------------------------
# IA générative                                      [adapté en phase 17]
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# PostgreSQL                                          [phase 2]
# -----------------------------------------------------------------------------
# Connexion unique (dev) — l'application est mono-instance en développement.
# Port 5433 : évite le conflit avec les autres projets locaux sur 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/katalyst"
# Base dédiée aux tests d'intégration.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/katalyst_test"

# -----------------------------------------------------------------------------
# Sélection des fournisseurs (zero vendor lock-in)    [phase 3]
# -----------------------------------------------------------------------------
DATA_PROVIDER="postgres"          # postgres | local
AUTH_PROVIDER="jwt"               # jwt
EMAIL_PROVIDER="smtp"             # smtp | resend | memory (memory = aucun envoi réel)
STORAGE_PROVIDER="local"          # local | s3
PAYMENT_PROVIDER="stripe"         # stripe

# Repli sur les données locales hors production (dev uniquement).
# En production, laisser vide : une panne de la base ne doit jamais être masquée.
USE_LOCAL_DATA=""

# -----------------------------------------------------------------------------
# Authentification                                    [phase 4]
# -----------------------------------------------------------------------------
JWT_SECRET=""
JWT_ACCESS_TTL="900"              # secondes (15 min)
JWT_REFRESH_TTL="2592000"         # secondes (30 jours)

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# SSO SAML (gate G1 — fournisseur à trancher)
# -----------------------------------------------------------------------------
# ⚠️ La paire de clés du fournisseur de service DOIT être stable : un certificat
# qui change à chaque redémarrage casse la confiance configurée chez le
# fournisseur d'identité, silencieusement.
# Générer une fois, puis conserver :
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout sp-key.pem -out sp-cert.pem \
#     -days 3650 -subj "/CN=katalyst-sp"
# Recopier le contenu des deux fichiers, en gardant les \n échappés.
SAML_SP_PRIVATE_KEY=""
SAML_SP_CERT=""
# Le certificat et l'URL du fournisseur d'identité se configurent PAR
# ORGANISATION, dans l'interface d'administration (colonne
# `organizations.saml_config`), et non ici : chaque institut a le sien.

# -----------------------------------------------------------------------------
# Connexion Google                                    [phase 4]
# -----------------------------------------------------------------------------
# ⚠️ SANS CES TROIS VALEURS, LA CONNEXION GOOGLE NE FONCTIONNE PAS.
# Le bouton « Continuer avec Google » renvoie alors sur /login avec le message
# « La connexion Google n'est pas configurée sur ce serveur ».
#
# Marche à suivre :
#   1. https://console.cloud.google.com/apis/credentials
#   2. « Créer un identifiant » → « ID client OAuth » → « Application Web »
#   3. URI de redirection autorisé :
#        http://localhost:3000/api/auth/google/callback   (développement)
#        https://votre-domaine/api/auth/google/callback   (production)
#   4. Recopier l'ID client et le secret ci-dessous, puis redémarrer le serveur.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# -----------------------------------------------------------------------------
# Email transactionnel                                [phase 3, gate G3]
# -----------------------------------------------------------------------------
# EMAIL_PROVIDER=smtp   → SMTP générique (repli documenté du gate G3)
# EMAIL_PROVIDER=resend → API Resend (sans SDK)
# EMAIL_PROVIDER=memory → aucun envoi réel : messages retenus en mémoire
#                         (tests, développement local)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"               # true pour le port 465 (TLS implicite)
SMTP_USER=""
SMTP_PASSWORD=""
# Expéditeur commun à tous les transports.
EMAIL_FROM="Katalyst <no-reply@example.com>"
# Alternative si EMAIL_PROVIDER=resend
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# Stockage des médias                                 [phase 3]
# -----------------------------------------------------------------------------
# STORAGE_PROVIDER=local → système de fichiers (aucun prérequis)
# STORAGE_PROVIDER=s3    → tout service compatible S3, sans SDK
# Répertoire racine du transport local (hors `public/` : les fichiers sont
# servis par la route `/api/files/[...key]`, avec contrôle d'accès).
STORAGE_LOCAL_DIR=".storage"
STORAGE_URL_PREFIX="/api/files/"
# Transport S3 (les cinq variables sont exigées si STORAGE_PROVIDER=s3).
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# -----------------------------------------------------------------------------
# Paiement                                            [phase 24, gate G4]
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# -----------------------------------------------------------------------------
# Fournisseurs IA                                     [phase 17, gate G4]
# -----------------------------------------------------------------------------
# Clés des fournisseurs utilisés par le studio de génération (TTT/TTI/TTS/STT/TTV).
AI_TTT_API_KEY=""
AI_TTI_API_KEY=""
AI_TTS_API_KEY=""
AI_STT_API_KEY=""
AI_TTV_API_KEY=""

# -----------------------------------------------------------------------------
# Double authentification                              [phase 4]
# -----------------------------------------------------------------------------
# Clé de chiffrement des secrets TOTP au repos (AES-256-GCM), 32 octets en
# base64. Elle vit HORS de la base : une fuite de la seule base ne doit pas
# permettre de générer des codes valides.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=""
# Nom affiché dans l'application d'authentification.
MFA_ISSUER="Katalyst"

# -----------------------------------------------------------------------------
# URL publique de l'application                         [phase 4]
# -----------------------------------------------------------------------------
# Sert à construire les liens envoyés par email (réinitialisation de mot de
# passe, invitations). En production, une valeur absente fait ÉCHOUER l'envoi
# plutôt que de produire un lien vers localhost.
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Limitation de débit                                  [phase 4]
# -----------------------------------------------------------------------------
# Facteur d'assouplissement des limites de débit. RÉSERVÉ AUX TESTS ET À LA CI :
# les tests E2E s'exécutent tous depuis la même adresse IP et atteindraient
# sinon la limite d'inscription (5 par heure).
# ⚠️ IGNORÉ EN PRODUCTION (voir src/lib/rate-limit.ts) : laisser vide.
RATE_LIMIT_MULTIPLIER=""

# -----------------------------------------------------------------------------
# Divers
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_TELEMETRY_DISABLED="1"
